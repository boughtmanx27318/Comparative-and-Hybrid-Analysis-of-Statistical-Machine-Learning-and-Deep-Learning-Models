import numpy as np
import pandas as pd
import yfinance as yf
import matplotlib.pyplot as plt
import seaborn as sns
from statsmodels.tsa.arima.model import ARIMA
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error
from sklearn.ensemble import RandomForestRegressor
from sklearn.svm import SVR
from xgboost import XGBRegressor
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, GRU, Dense

# ------------------ HELPER ------------------
def rmse(y, pred):
    return np.sqrt(mean_squared_error(y, pred))

# ------------------ STOCK LIST ------------------
stocks = ["RELIANCE.NS", "TCS.NS", "INFY.NS"]

# ------------------ LOOP ------------------
for stock in stocks:
    print(f"\n🚀 Running for {stock}\n")

    # ------------------ DATA ------------------
    data = yf.download(stock, start="2019-01-01", end="2024-01-01")
    prices = data['Close'].dropna().values

    # ------------------ SCALING ------------------
    scaler = MinMaxScaler()
    scaled = scaler.fit_transform(prices.reshape(-1,1))

    # ------------------ WINDOW ------------------
    window = 10
    X, y = [], []

    for i in range(len(scaled)-window):
        X.append(scaled[i:i+window])
        y.append(scaled[i+window])

    X, y = np.array(X), np.array(y)

    # ------------------ SPLIT ------------------
    train_size = int(len(X)*0.8)

    X_train, X_test = X[:train_size], X[train_size:]
    y_train, y_test = y[:train_size], y[train_size:]

    X_train_flat = X_train.reshape(X_train.shape[0], -1)
    X_test_flat = X_test.reshape(X_test.shape[0], -1)

    y_test_actual = scaler.inverse_transform(y_test).flatten()

    # ------------------ ARIMA ------------------
    train_arima = prices[:train_size+window]
    test_arima = prices[train_size+window:]

    arima = ARIMA(train_arima, order=(5,1,0)).fit()
    arima_pred = arima.forecast(steps=len(test_arima))

    # ------------------ LSTM ------------------
    lstm = Sequential([
        LSTM(50, input_shape=(window,1)),
        Dense(1)
    ])
    lstm.compile(optimizer='adam', loss='mse')
    lstm.fit(X_train, y_train, epochs=20, verbose=0)

    lstm_pred = scaler.inverse_transform(lstm.predict(X_test)).flatten()

    # ------------------ GRU ------------------
    gru = Sequential([
        GRU(50, input_shape=(window,1)),
        Dense(1)
    ])
    gru.compile(optimizer='adam', loss='mse')
    gru.fit(X_train, y_train, epochs=20, verbose=0)

    gru_pred = scaler.inverse_transform(gru.predict(X_test)).flatten()

    # ------------------ ML MODELS ------------------
    rf = RandomForestRegressor(n_estimators=100)
    rf.fit(X_train_flat, scaler.inverse_transform(y_train).flatten())
    rf_pred = rf.predict(X_test_flat)

    svr = SVR()
    svr.fit(X_train_flat, scaler.inverse_transform(y_train).flatten())
    svr_pred = svr.predict(X_test_flat)

    xgb = XGBRegressor(n_estimators=100, verbosity=0)
    xgb.fit(X_train_flat, scaler.inverse_transform(y_train).flatten())
    xgb_pred = xgb.predict(X_test_flat)

    # ------------------ ALIGN ------------------
    min_len = min(len(y_test_actual), len(arima_pred))

    y_true = y_test_actual[:min_len]

    results = {
        "ARIMA": arima_pred[:min_len],
        "LSTM": lstm_pred[:min_len],
        "GRU": gru_pred[:min_len],
        "RandomForest": rf_pred[:min_len],
        "SVR": svr_pred[:min_len],
        "XGBoost": xgb_pred[:min_len]
    }

    # ------------------ TABLE ------------------
    results_df = pd.DataFrame(results)
    results_df["Actual"] = y_true

    print("📊 Sample Predictions:")
    print(results_df.head())

    results_df.to_csv(f"{stock}_results.csv", index=False)

    # ------------------ ACCURACY ------------------
    accuracy = []

    for model, pred in results.items():
        accuracy.append([model, rmse(y_true, pred)])

    accuracy_df = pd.DataFrame(accuracy, columns=["Model", "RMSE"])

    print("\n📈 Accuracy:")
    print(accuracy_df)

    accuracy_df.to_csv(f"{stock}_accuracy.csv", index=False)

    # ------------------ GRAPH ------------------
    plt.figure(figsize=(12,6))
    plt.plot(y_true, label="Actual", linewidth=2)

    for model, pred in results.items():
        plt.plot(pred, label=model)

    plt.legend()
    plt.title(f"{stock} - Model Comparison")
    plt.grid(True)
    plt.show()

    # ------------------ RMSE BAR ------------------
    plt.figure(figsize=(8,5))
    sns.barplot(x="Model", y="RMSE", data=accuracy_df)
    plt.title(f"{stock} - RMSE Comparison")
    plt.xticks(rotation=30)
    plt.grid(True)
    plt.show()
